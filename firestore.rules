rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid))
        && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.get('approved', false) == true;
    }

    function isAdmin() {
      return isTeacher()
        && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.get('admin', false) == true;
    }

    function classPath(classId) {
      return /databases/$(database)/documents/classes/$(classId);
    }

    function isClassTeacher(classId) {
      return isTeacher() && classId is string && exists(classPath(classId))
        && request.auth.uid in get(classPath(classId)).data.teacherIds;
    }

    function devicePath() {
      return /databases/$(database)/documents/devices/$(request.auth.uid);
    }

    // A shared tablet temporarily belongs to another class while a teacher's class session runs.
    function sessionActive(device) {
      return device.get('activeClassId', null) != null && request.time < device.activeUntil;
    }

    function deviceInClass(classId) {
      return signedIn() && exists(devicePath())
        && (get(devicePath()).data.classId == classId
          || (sessionActive(get(devicePath()).data) && get(devicePath()).data.activeClassId == classId));
    }

    function rosterHas(classId, code) {
      return code is string && exists(/databases/$(database)/documents/classes/$(classId)/students/$(code))
        && get(/databases/$(database)/documents/classes/$(classId)/students/$(code)).data.active == true;
    }

    function canCreateActivity() {
      return signedIn() && (
        request.auth.token.firebase.sign_in_provider == 'anonymous' || isTeacher()
      );
    }

    function shortText(value, maximum) {
      return value is string && value.size() > 0 && value.size() <= maximum;
    }

    function validId(value) {
      return shortText(value, 100) && value.matches('^[a-zA-Z0-9_-]+$');
    }

    function validStatus(value) {
      return value in ['완료', '확인 필요', '도움 요청', '처리 완료', '활동 중'];
    }

    // Students cannot create an already-handled record; only teachers resolve.
    function validStudentStatus(value) {
      return value in ['완료', '확인 필요', '도움 요청', '활동 중'];
    }

    function strongDiscomfort(emotion, intensity) {
      return emotion in ['속상해요', '화가나요', '힘들어요'] && intensity == 5;
    }

    function validIntensity(value) {
      return value is int && value >= 1 && value <= 5;
    }

    function validLearnerCode(value) {
      return value == null || (shortText(value, 32) && value.matches('^[a-zA-Z0-9_-]+$'));
    }

    function missingAnswer(value, reason) {
      return (value == null && reason in ['not-asked', 'unsure', 'skipped', 'interrupted', 'unconfirmed'])
        || (value != null && reason == null);
    }

    function validMood(emotion, intensity, emotionReason, intensityReason) {
      return (emotion == null || shortText(emotion, 100))
        && (intensity == null || validIntensity(intensity))
        && (emotion != null || intensity == null)
        && missingAnswer(emotion, emotionReason)
        && missingAnswer(intensity, intensityReason);
    }

    function validAfterEmotion(data) {
      return (!('afterEmotion' in data) && !('afterIntensity' in data))
        || (('afterEmotion' in data) && ('afterIntensity' in data)
          && shortText(data.afterEmotion, 100) && validIntensity(data.afterIntensity));
    }

    function validLegacyAnswers(data) {
      return !data.keys().hasAny([
          'schemaVersion', 'learnerCode', 'recordKind', 'activityOutcome', 'appVersion', 'alertTrigger',
          'beforeEmotionMissingReason', 'beforeIntensityMissingReason',
          'afterEmotionMissingReason', 'afterIntensityMissingReason'
        ])
        && shortText(data.emotion, 100) && validIntensity(data.intensity)
        && validAfterEmotion(data);
    }

    function validVersion2Answers(data) {
      return data.keys().hasAll([
          'schemaVersion', 'learnerCode', 'recordKind', 'afterEmotion', 'afterIntensity',
          'beforeEmotionMissingReason', 'beforeIntensityMissingReason',
          'afterEmotionMissingReason', 'afterIntensityMissingReason'
        ])
        && data.schemaVersion == 2
        && validLearnerCode(data.learnerCode)
        && data.recordKind in ['activity', 'help', 'check-in']
        && (!('alertTrigger' in data) || data.alertTrigger in ['help-button', 'negative-intensity'])
        && ((data.recordKind == 'activity' && data.get('activityOutcome', '') in ['completed', 'interrupted']
              && data.completed == (data.activityOutcome == 'completed'))
          || (data.recordKind != 'activity' && !('activityOutcome' in data)))
        && (!('appVersion' in data) || (shortText(data.appVersion, 64) && data.appVersion.matches('^[a-zA-Z0-9._+-]+$')))
        && validMood(data.emotion, data.intensity, data.beforeEmotionMissingReason, data.beforeIntensityMissingReason)
        && validMood(data.afterEmotion, data.afterIntensity, data.afterEmotionMissingReason, data.afterIntensityMissingReason);
    }

    // Who a record belongs to comes from the registered device or the class roster,
    // never from free text typed on a student screen.
    function validIdentity(data) {
      let session = get(/databases/$(database)/documents/learningSessions/$(request.auth.uid + '_' + data.sessionId)).data;
      return exists(devicePath()) && session.deviceId == request.auth.uid
        && request.time < session.expiresAt
        && data.classId == session.classId && data.learnerCode == session.learnerCode
        && data.identifiedBy == session.identifiedBy
        && (data.get('learnerCode', null) != null || data.get('recordKind', '') == 'help')
        && (session.get('purpose', 'learning') != 'help' || data.get('recordKind', '') == 'help');
    }

    function approvedClassTeacher(uid, classId) {
      return uid is string && exists(/databases/$(database)/documents/teachers/$(uid))
        && get(/databases/$(database)/documents/teachers/$(uid)).data.get('approved', false) == true
        && uid in get(classPath(classId)).data.teacherIds;
    }

    function matchesCurrentDevice(data, device) {
      let active = device.kind == 'shared' && sessionActive(device);
      let classId = active ? device.activeClassId : device.classId;
      let code = device.kind == 'student' ? device.studentCode : (active ? device.activeStudentCode : null);
      let symbol = active && device.get('activeSelectionMode', 'teacher') == 'symbol' && code == null
        && data.get('purpose', 'learning') in ['learning', 'help'] && rosterHas(classId, data.learnerCode);
      return data.classId == classId && (symbol || data.learnerCode == code)
        && data.identifiedBy == (symbol ? 'symbol' : device.kind == 'student' ? 'device' : (code == null ? 'none' : 'teacher-before'))
        && data.teacherUid == (active ? device.activeTeacherUid : device.registeredBy)
        && data.assignmentId == (active ? device.assignmentId : null)
        && (code == null || rosterHas(classId, code))
        && approvedClassTeacher(data.teacherUid, classId);
    }

    function needsMail(data) {
      return data.helpRequested == true || data.get('recordKind', '') == 'help'
        || strongDiscomfort(data.emotion, data.intensity)
        || strongDiscomfort(data.get('afterEmotion', null), data.get('afterIntensity', null));
    }

    function observationOnly(data) {
      return data.get('recordKind', null) == 'observation';
    }

    // A teacher's observation of a student who did not use the app: a fixed shape with no
    // self-report, a roster student, and the observation stamped like a later observation edit.
    function validObservationCreate(data, recordId) {
      return isTeacher()
        && data.diff({
            'student': 'teacher-observation', 'studentName': '교사 관찰', 'difficulty': '해당 없음', 'technique': '교사 관찰',
            'emotion': null, 'intensity': null, 'afterEmotion': null, 'afterIntensity': null,
            'beforeEmotionMissingReason': 'not-asked', 'beforeIntensityMissingReason': 'not-asked',
            'afterEmotionMissingReason': 'not-asked', 'afterIntensityMissingReason': 'not-asked',
            'schemaVersion': 2, 'recordKind': 'observation', 'identifiedBy': 'teacher-before',
            'completed': false, 'helpRequested': false, 'interventionNeeded': false, 'status': '완료'
          }).affectedKeys().hasOnly([
            'createdAt', 'createdBy', 'eventId', 'classId', 'learnerCode',
            'observation', 'observationUpdatedAt', 'observationUpdatedBy', 'usageMode'
          ])
        && data.keys().hasAll([
          'createdAt', 'createdBy', 'eventId', 'classId', 'learnerCode',
          'observation', 'observationUpdatedAt', 'observationUpdatedBy'
        ])
        && data.get('usageMode','live') == 'live'
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time
        && validId(data.eventId)
        && recordId == request.auth.uid + '_' + data.eventId
        && isClassTeacher(data.classId)
        && rosterHas(data.classId, data.learnerCode)
        && data.observationUpdatedBy == request.auth.uid
        && data.observationUpdatedAt == request.time
        && validObservation(data.observation);
    }

    function validCreate(data, recordId) {
      return data.keys().hasAll([
          'createdAt', 'createdBy', 'eventId', 'student', 'studentName',
          'difficulty', 'emotion', 'intensity', 'technique', 'completed',
          'helpRequested', 'status', 'interventionNeeded'
        ])
        && data.keys().hasOnly([
          'createdAt', 'createdBy', 'eventId', 'sessionId', 'practiceSummary',
          'student', 'studentName', 'difficulty', 'emotion', 'intensity',
          'afterEmotion', 'afterIntensity',
          'schemaVersion', 'learnerCode', 'recordKind', 'activityOutcome', 'appVersion', 'alertTrigger',
          'beforeEmotionMissingReason', 'beforeIntensityMissingReason',
          'afterEmotionMissingReason', 'afterIntensityMissingReason',
          'technique', 'completed', 'helpRequested', 'status', 'interventionNeeded',
          'classId', 'identifiedBy', 'usageMode'
        ])
        && data.keys().hasAll(['classId', 'identifiedBy'])
        && data.get('usageMode', 'live') == 'live'
        && validIdentity(data)
        && (!needsMail(data) || existsAfter(/databases/$(database)/documents/mailDeliveries/$(recordId)))
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time
        && validId(data.eventId)
        && recordId == request.auth.uid + '_' + data.eventId
        && (!('sessionId' in data) || validId(data.sessionId))
        && (!('practiceSummary' in data) || shortText(data.practiceSummary, 1000))
        && shortText(data.student, 100)
        && shortText(data.studentName, 100)
        && data.difficulty in ['글', '그림+단어', '그림']
        && (('schemaVersion' in data) ? validVersion2Answers(data) : validLegacyAnswers(data))
        && shortText(data.technique, 100)
        && data.completed is bool
        && data.helpRequested is bool
        && data.interventionNeeded is bool
        && validStudentStatus(data.status)
        && (data.helpRequested != true || data.interventionNeeded == true)
        && ((!strongDiscomfort(data.emotion, data.intensity)
            && !strongDiscomfort(data.get('afterEmotion', null), data.get('afterIntensity', null)))
          || data.interventionNeeded == true);
    }

    function nullableCount(value) {
      return value == null || (value is int && value >= 0 && value <= 100000);
    }

    function nullableMeasure(value, maximum) {
      return value == null || (value is number && value >= 0 && value <= maximum);
    }

    function validInputSupport(value) {
      return value in ['unknown', 'independent', 'access-assisted', 'prompted'];
    }

    function validObservation(value) {
      return value is map
        && value.keys().hasAll([
          'context', 'requestOpportunities', 'independentRequests', 'promptLevel', 'supportOutcome',
          'targetBehavior', 'behaviorCount', 'behaviorDurationSeconds', 'observationMinutes',
          'beforeInputSupport', 'afterInputSupport', 'note', 'setting', 'communicationPartner', 'participationMinutes'
        ])
        && value.keys().hasOnly([
          'context', 'requestOpportunities', 'independentRequests', 'promptLevel', 'supportOutcome',
          'targetBehavior', 'behaviorCount', 'behaviorDurationSeconds', 'observationMinutes',
          'beforeInputSupport', 'afterInputSupport', 'note', 'setting', 'communicationPartner', 'participationMinutes'
        ])
        && value.context in ['not-recorded', 'practice', 'daily-life']
        && value.promptLevel in ['not-recorded', 'independent', 'verbal', 'model', 'together', 'not-observed']
        && value.supportOutcome in ['not-recorded', 'provided', 'partly-provided', 'not-provided', 'no-request']
        && nullableCount(value.requestOpportunities)
        && nullableCount(value.independentRequests)
        && (value.independentRequests == null || (value.requestOpportunities != null && value.independentRequests <= value.requestOpportunities))
        && nullableCount(value.behaviorCount)
        && nullableMeasure(value.behaviorDurationSeconds, 86400)
        && nullableMeasure(value.observationMinutes, 1440)
        && nullableMeasure(value.participationMinutes, 1440)
        && (value.participationMinutes == null || value.observationMinutes == null || value.participationMinutes <= value.observationMinutes)
        && value.setting is string && value.setting.size() <= 100
        && value.communicationPartner is string && value.communicationPartner.size() <= 100
        && (value.behaviorDurationSeconds == null || value.observationMinutes == null
          || value.behaviorDurationSeconds <= value.observationMinutes * 60)
        && value.targetBehavior is string && value.targetBehavior.size() <= 100
        && value.note is string && value.note.size() <= 1000
        && validInputSupport(value.beforeInputSupport) && validInputSupport(value.afterInputSupport);
    }

    function validTeacherUpdate() {
      let changes = request.resource.data.diff(resource.data).affectedKeys();
      let data = request.resource.data;
      return changes.hasOnly([
          'status', 'helpRequested', 'interventionNeeded', 'learnerCode',
          'observation', 'observationUpdatedAt', 'observationUpdatedBy',
          'statusUpdatedAt', 'statusUpdatedBy', 'identifiedBy', 'learnerAssignedAt', 'learnerAssignedBy', 'usageMode', 'usageUpdatedAt', 'usageUpdatedBy'
        ])
        && (!changes.hasAny(['usageMode','usageUpdatedAt','usageUpdatedBy']) || (data.usageMode in ['live','test','unknown'] && data.usageUpdatedBy == request.auth.uid && data.usageUpdatedAt == request.time))
        // A later assignment names the teacher and time, and must use the class roster.
        && (!changes.hasAny(['learnerCode', 'identifiedBy', 'learnerAssignedAt', 'learnerAssignedBy'])
          || (data.identifiedBy == 'teacher-after'
            && data.learnerAssignedBy == request.auth.uid
            && data.learnerAssignedAt == request.time
            && (data.get('learnerCode', null) == null || rosterHas(data.get('classId', null), data.learnerCode))))
        && validStatus(data.status)
        && (!changes.hasAny(['status', 'statusUpdatedAt', 'statusUpdatedBy'])
          || (data.statusUpdatedBy == request.auth.uid && data.statusUpdatedAt == request.time))
        && data.get('helpRequested', false) is bool
        && data.get('interventionNeeded', false) is bool
        && (!changes.hasAny(['learnerCode']) || validLearnerCode(data.learnerCode))
        && (!changes.hasAny(['observation', 'observationUpdatedAt', 'observationUpdatedBy'])
          || (data.keys().hasAll(['observation', 'observationUpdatedAt', 'observationUpdatedBy'])
            && validObservation(data.observation)
            && data.observationUpdatedAt == request.time
            && data.observationUpdatedBy == request.auth.uid));
    }

    // Default seat map for a class session: shared tablet ID -> student code ('' = empty seat).
    function validSeats(value) {
      return value is map && value.size() <= 40;
    }

    function validClassName(value) {
      return shortText(value, 40);
    }

    match /classes/{classId} {
      allow get: if isClassTeacher(classId) || deviceInClass(classId);
      allow list: if isTeacher() && request.auth.uid in resource.data.teacherIds;
      allow create: if isTeacher() && validId(classId)
        && request.resource.data.keys().hasOnly(['name', 'teacherIds', 'active', 'createdBy', 'createdAt', 'seats'])
        && validSeats(request.resource.data.get('seats', {}))
        && validClassName(request.resource.data.name)
        && request.resource.data.teacherIds == [request.auth.uid]
        && request.resource.data.active == true
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isClassTeacher(classId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'teacherIds', 'active', 'seats'])
        && validSeats(request.resource.data.get('seats', {}))
        && validClassName(request.resource.data.name)
        && request.resource.data.teacherIds is list
        && request.resource.data.teacherIds.size() <= 10
        && request.auth.uid in request.resource.data.teacherIds
        && request.resource.data.active is bool;
      allow delete: if false;

      // Rosters hold teacher-chosen aliases only, never real names.
      match /students/{code} {
        allow get, list: if isClassTeacher(classId) || deviceInClass(classId);
        allow create, update: if isClassTeacher(classId)
          && code.matches('^[A-Za-z0-9_-]{1,32}$')
          && request.resource.data.keys().hasOnly(['alias', 'symbol', 'active', 'createdAt'])
          && shortText(request.resource.data.alias, 20)
          && request.resource.data.symbol is string && request.resource.data.symbol.size() <= 8
          && request.resource.data.active is bool
          && (resource == null
            ? request.resource.data.createdAt == request.time
            : request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if false;
      }
    }

    function validDevice(data, deviceId) {
      return data.keys().hasOnly(['classId', 'kind', 'studentCode', 'label', 'registeredBy', 'registeredAt',
          'activeClassId', 'activeStudentCode', 'activeUntil', 'activeTeacherUid', 'assignmentId', 'activeSelectionMode'])
        && data.get('activeSelectionMode', 'teacher') in ['teacher', 'symbol']
        && data.get('activeClassId', null) == null
        && isClassTeacher(data.classId)
        && shortText(data.label, 30)
        && data.registeredBy == request.auth.uid
        && data.registeredAt == request.time
        && deviceId != request.auth.uid
        && ((data.kind == 'student' && rosterHas(data.classId, data.studentCode))
          || (data.kind == 'shared' && data.studentCode == null));
    }

    // Starting or ending a class session on a shared tablet the teacher manages.
    function validSessionChange() {
      let data = request.resource.data;
      return resource.data.kind == 'shared'
        && data.get('activeSelectionMode', 'teacher') in ['teacher', 'symbol']
        && (data.get('activeSelectionMode', 'teacher') != 'symbol' || data.get('activeStudentCode', null) == null)
        && data.diff(resource.data).affectedKeys().hasOnly(['activeClassId', 'activeStudentCode', 'activeUntil', 'activeTeacherUid', 'assignmentId', 'activeSelectionMode'])
        && (data.get('activeClassId', null) == null
          ? data.get('activeStudentCode', null) == null && data.get('activeUntil', null) == null
            && data.get('activeTeacherUid', null) == null && data.get('assignmentId', null) == null
          : isClassTeacher(data.activeClassId)
            && approvedClassTeacher(data.activeTeacherUid, data.activeClassId)
            && (data.activeTeacherUid == request.auth.uid || data.activeTeacherUid == resource.data.get('activeTeacherUid', null))
            && validId(data.assignmentId)
            && (data.activeStudentCode == null || rosterHas(data.activeClassId, data.activeStudentCode))
            && data.activeUntil is timestamp
            && data.activeUntil > request.time
            && data.activeUntil <= request.time + duration.value(4, 'h'));
    }

    // A device is a student browser's anonymous identity, registered by a teacher.
    match /devices/{deviceId} {
      allow get: if (signedIn() && request.auth.uid == deviceId) || isClassTeacher(resource.data.classId);
      allow list: if isClassTeacher(resource.data.classId);
      allow create: if validDevice(request.resource.data, deviceId);
      allow update: if isClassTeacher(resource.data.classId)
        && (validDevice(request.resource.data, deviceId) || validSessionChange());
      allow delete: if isClassTeacher(resource.data.classId);
    }

    match /teachers/{teacherUid} {
      // Approvals are created by the project owner in the Firebase console/Admin SDK.
      allow get: if signedIn() && request.auth.uid == teacherUid;
      allow list, create, update, delete: if false;
    }

    // Teacher-private schedule; no student names or uploaded source files are stored.
    match /teachers/{uid}/timetable/{entryId} {
      allow read: if isTeacher() && request.auth.uid == uid;
      allow create, update: if isTeacher() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['weekday','classId','startTime','endTime','effectiveFrom','effectiveUntil','active','updatedAt'])
        && isClassTeacher(request.resource.data.classId)
        && request.resource.data.weekday is int && request.resource.data.weekday >= 0 && request.resource.data.weekday <= 6
        && request.resource.data.effectiveFrom.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (request.resource.data.get('effectiveUntil', '') == '' || (request.resource.data.effectiveUntil.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && request.resource.data.effectiveUntil >= request.resource.data.effectiveFrom))
        && ((request.resource.data.startTime == '' && request.resource.data.endTime == '')
          || (request.resource.data.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
            && request.resource.data.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
            && request.resource.data.startTime < request.resource.data.endTime))
        && request.resource.data.active is bool && request.resource.data.updatedAt == request.time;
      allow delete: if isTeacher() && request.auth.uid == uid;
    }

    match /teacherAlertProfiles/{uid} {
      allow get: if isTeacher() && request.auth.uid == uid;
      allow create, update: if isTeacher() && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['email', 'updatedAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.updatedAt == request.time;
      allow list, delete: if false;
    }

    match /mailServiceHealth/{id} {
      allow get: if isTeacher() && id == 'current';
      allow list, write: if false;
    }

    match /learningSessions/{id} {
      allow get: if signedIn() && resource.data.deviceId == request.auth.uid;
      allow create: if canCreateActivity() && exists(devicePath())
        && request.resource.data.keys().hasOnly(['deviceId', 'sessionId', 'classId', 'learnerCode', 'identifiedBy',
          'teacherUid', 'assignmentId', 'createdAt', 'expiresAt', 'purpose'])
        && request.resource.data.deviceId == request.auth.uid
        && validId(request.resource.data.sessionId)
        && id == request.auth.uid + '_' + request.resource.data.sessionId
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(4, 'h')
        && request.resource.data.get('purpose', 'learning') in ['learning', 'help']
        // Older clients omitted purpose; permit their help requests, never unassigned activity writes.
        && (request.resource.data.get('purpose', 'help') == 'help' || request.resource.data.learnerCode != null)
        && matchesCurrentDevice(request.resource.data, get(devicePath()).data);
      allow list, update, delete: if false;
    }

    match /mailDeliveries/{id} {
      allow get: if (resource == null && isTeacher()) || (signedIn() && resource.data.createdBy == request.auth.uid)
        || isClassTeacher(resource.data.classId);
      allow list: if isClassTeacher(resource.data.classId) && request.query.limit <= 100;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['classId', 'createdBy', 'createdAt', 'updatedAt', 'status', 'reason',
          'attempts', 'supportResolved', 'closed', 'nextAttemptAt', 'learnerCode', 'deviceLabel'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.nextAttemptAt == request.time
        && request.resource.data.status == 'pending' && request.resource.data.reason == 'queued'
        && request.resource.data.attempts == 0 && request.resource.data.supportResolved == false && request.resource.data.closed == false
        && getAfter(/databases/$(database)/documents/activityRecords/$(id)).data.createdBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/activityRecords/$(id)).data.classId == request.resource.data.classId
        && getAfter(/databases/$(database)/documents/activityRecords/$(id)).data.learnerCode == request.resource.data.learnerCode
        && get(devicePath()).data.label == request.resource.data.deviceLabel
        && getAfter(/databases/$(database)/documents/activityRecords/$(id)).data.createdAt == request.time
        && needsMail(getAfter(/databases/$(database)/documents/activityRecords/$(id)).data);
      // Only the Apps Script owner's IAM-authorized server can change delivery status.
      allow update: if isClassTeacher(resource.data.classId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supportResolved', 'closed', 'supportUpdatedBy', 'supportUpdatedAt'])
        && request.resource.data.supportUpdatedBy == request.auth.uid && request.resource.data.supportUpdatedAt == request.time
        && request.resource.data.supportResolved == (getAfter(/databases/$(database)/documents/activityRecords/$(id)).data.status == '처리 완료')
        && request.resource.data.closed == (request.resource.data.supportResolved && resource.data.status == 'sent');
      allow delete: if false;
    }

    match /activityRecords/{recordId} {
      allow create: if canCreateActivity() && (observationOnly(request.resource.data)
        ? validObservationCreate(request.resource.data, recordId)
        : validCreate(request.resource.data, recordId));
      // Teachers see only their own classes; the project owner (admin) also sees unassigned records.
      allow get: if isAdmin() || isClassTeacher(resource.data.get('classId', null));
      allow list: if request.query.limit <= 100
        && (isAdmin() || isClassTeacher(resource.data.get('classId', null)));
      // Teacher observations and pseudocodes are additive. Original self-reports are immutable.
      allow update: if (isAdmin() || isClassTeacher(resource.data.get('classId', null))) && validTeacherUpdate();
      allow delete: if isAdmin() || isClassTeacher(resource.data.get('classId', null));
    }

    // Connectivity marker only. It does not prove the whole ruleset is secure or matches this file.
    // Keep the version in step with RULES_VERSION in src/lib/liveSetupCheck.ts.
    match /rulesVersion/{version} {
      allow get: if version in ['mindgps-2026-10-11', 'mindgps-2026-10-12'];
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
