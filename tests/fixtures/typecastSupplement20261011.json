{
  "sourceSha256": "fe13f673a1b5c923121bb5ac95d4dce1f0f56cda4b2eb26e6789a8c47df79836",
  "clips": [
    {
      "id": "add-20261011-01",
      "text": "친구가 나를 놀리는 말을 해요.",
      "fileName": "add-20261011-01.mp3",
      "sha256": "e967ab1d90903f184f24203d8a9c2c7817083631936494a241b9f92884cc7498"
    },
    {
      "id": "add-20261011-02",
      "text": "지금 하는 활동이 어려워요.",
      "fileName": "add-20261011-02.mp3",
      "sha256": "98815a68766a400aca5c50f87245fb1e0833f63189e0daaf1cc3c83ea44f2ba5"
    },
    {
      "id": "add-20261011-03",
      "text": "주변 사람이 큰 목소리로 말해요.",
      "fileName": "add-20261011-03.mp3",
      "sha256": "195f1b797e83258f35968d4e565a83cf0f002170984af66dcd1117ac5f8c4105"
    },
    {
      "id": "add-20261011-04",
      "text": "불편해요",
      "fileName": "add-20261011-04.mp3",
      "sha256": "4f8bf347f0ca25cd1740ed3e882d621361382745fa8a25dd4f39e76d25f13b75"
    },
    {
      "id": "add-20261011-05",
      "text": "화가 나요",
      "fileName": "add-20261011-05.mp3",
      "sha256": "5a3523502d81117c29f7709f889bea56f326e5673a51450c24974ed9a55b773d"
    },
    {
      "id": "add-20261011-06",
      "text": "속상해요",
      "fileName": "add-20261011-06.mp3",
      "sha256": "1de32cee3ae2eea83b49aa1307ac62fc21e57a498de5b8d35adb56369a209179"
    },
    {
      "id": "add-20261011-07",
      "text": "걱정이 돼요",
      "fileName": "add-20261011-07.mp3",
      "sha256": "667ce7396e0d18a34788ff7a6ff228c2785a00a17c95b360860e39d9a1ed4659"
    },
    {
      "id": "add-20261011-08",
      "text": "실수했다고 나쁜 친구가 되는 건 아니야.",
      "fileName": "add-20261011-08.mp3",
      "sha256": "83377d9842e9dabf45bff8090ad92fea7030e3a417bee5135f79eb9ced951931"
    }
