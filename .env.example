# This setting overrides app-mode.json. Without it, app-mode.json decides (demo unless it says live).
# Demo keeps trial records in memory only (the teacher screen shows the latest 100); reloading removes them.
# Misspelled or other values use demo.
VITE_DATA_MODE=demo

# Set live only after completing docs/DATA_SETUP.md and deploying Firestore rules.
# Firebase connection details remain in firebase-applet-config.json.
# VITE_DATA_MODE=live

# Local testing only: connect to the Firebase emulators (see docs/DATA_SETUP.md). Never set this for a real build.
# VITE_FIREBASE_EMULATOR=true

# Required for immediate emergency email in live mode. Deploy services/apps-script first.
# Receives authenticated record IDs; delivery results are verified in Firestore.
# This browser-visible URL is NOT a password or a secure administrator credential.
# Do not put private keys or administrator codes in VITE_ variables.
VITE_GOOGLE_SCRIPT_URL=

# The current learning activities use bundled content, not Gemini API calls.
# No GEMINI_API_KEY is needed for this version.
